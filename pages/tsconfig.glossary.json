{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "react": ["pages/node_modules/@types/react"],
      "react/jsx-runtime": ["pages/node_modules/@types/react/jsx-runtime.d.ts"],
      "lucide-react": ["pages/node_modules/lucide-react"]
    },
    "types": []
  },
  "include": ["../app/glossary.tsx", "../app/glossary-entry.tsx", "../app/cataloguer.tsx", "../lib/glossary.ts"]
}
